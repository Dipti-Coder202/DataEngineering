# PostgreSQL source
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_db
DB_USER=retail_user
DB_PASSWORD=replace_with_your_local_password
DB_SOURCE_TABLE=retail_sales

# Local Spark learning environment
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4

# Download this driver during setup; do not commit binary JAR files.
JDBC_JAR_PATH=jars/postgresql-42.7.7.jar
